# Secure RAG Platform — environment template
# Copy to `.env` and configure. Never commit real secrets.

# ─── Security & Authentication ───────────────────────────────────────────────
APP_ENV=dev
SECRET_KEY=change-me-long-random-at-least-32-chars
# Comma-separated browser origins allowed to call the API (recommended in prod)
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# Demo login passwords (dev only; min 12 chars). Used by seed_dev_accounts.
DEMO_PASSWORD_EMPLOYEE=ChangeMeEmployee12!
DEMO_PASSWORD_HR=ChangeMeHrPassword12!
DEMO_PASSWORD_ADMIN=ChangeMeAdminPass12!

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: ollama (default, local), groq (cloud), mock (testing)
LLM_PROVIDER=ollama
GROQ_API_KEY=

# ─── Database & Storage ──────────────────────────────────────────────────────
DB_PATH=data/nexus.db
SQLITE_PATH=data/nexus.db
CHROMA_PERSIST_DIR=data/chroma

# ─── API / Client ────────────────────────────────────────────────────────────
API_BASE_URL=http://127.0.0.1:8000
# API_HOST: Defaults to 127.0.0.1 (loopback only). Set to 0.0.0.0 ONLY behind a reverse proxy.
# API_HOST=127.0.0.1

# ─── Feature Flags ───────────────────────────────────────────────────────────
ENABLE_WEB_SEARCH=false

# ─── Demo Seeding ────────────────────────────────────────────────────────────
# Set to 1 on FIRST BOOT ONLY to create demo accounts, then set back to 0.
# WARNING: DEMO_FORCE_RESEED=1 deletes the SQLite database on every restart!
DEMO_FORCE_RESEED=0

# Display demo credentials in Streamlit UI (dev convenience only).
# Even in dev mode, credentials are hidden unless this is explicitly set to 1.
SHOW_DEMO_CREDENTIALS=0

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Set to 1 for fast CI/tests (FakeEmbedder). Leave unset / 0 for SentenceTransformer.
EMBEDDING_FAKE=0

# ─── TLS / HTTPS ─────────────────────────────────────────────────────────────
# IMPORTANT: Never expose the uvicorn HTTP server directly to the internet.
# Always deploy behind a TLS-terminating reverse proxy (e.g. nginx, Caddy, Traefik).
# Example nginx config:
#   server {
#       listen 443 ssl;
#       ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
#       ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
#       location / { proxy_pass http://127.0.0.1:8000; }
#   }
# Set API_HOST=127.0.0.1 (default) and let the reverse proxy handle external traffic.
